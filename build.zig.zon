.{
    .name = .notui,
    .version = "0.0.0",
    .fingerprint = 0xb6bb4da781f0147a, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .zg = .{
            .url = "https://codeberg.org/atman/zg/archive/v0.16.2.tar.gz",
            .hash = "zg-0.16.2-oGqU3HqftgI6rwFS90ypwfjgToH8Pz829OKuFURlm773",
        },
        // skript: the Lisp runtime embedded by examples/skript_repl.zig.
        // VENDORED (vendor/skript) — a copy of ../skript's consumer
        // surface: build.zig, build.zig.zon, build_web.zig, src, test,
        // demo, web, third_party/zigzag. That is exactly skript's own
        // `.paths` set, so the copy is what a downstream consumer of
        // skript would receive. Re-vendor with:
        //   (cd ../skript && jj file list -r @) \
        //     | grep -E '^(src|test|demo|web|third_party/zigzag)/|^(build\.zig|build\.zig\.zon|build_web\.zig)$' \
        //     | rsync -a --files-from=- ../skript/ vendor/skript/
        // A .path dep skips the hash. skript's own build pulls its deps
        // (tracy git fetch — expected; libffi is lazy and skipped via
        // .enable_libffi = false in build.zig).
        .skript = .{ .path = "vendor/skript" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "vendor",
    },
}
