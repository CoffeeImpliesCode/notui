.{
    .name = .notui,
    .version = "0.1.0",
    .fingerprint = 0xb6bb4da781f0147a, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .zg = .{
            .url = "git+https://codeberg.org/atman/zg?ref=refs/pull/108/head#2c888c632754ef0f16e17595a6d9bd2f852ef7af",
            .hash = "zg-0.18.0-oGqU3MDboAKAOyNrpklU8sgEVTGZR0JxxYCcQdjJMDYw",
        },
        // Native Skript consumer sources. The unshipped Emscripten dependency
        // and its web build helpers are excluded from this vendored build.
        .skript = .{ .path = "vendor/skript" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "bench",
        "examples",
        "README.md",
        "FAST_COVERAGE.md",
        "vendor",
    },
}
