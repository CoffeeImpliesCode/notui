#!/usr/bin/env skript
; types.pt — type introspection
; type predicates, @-intrinsics, type values as first-class data
; flat type hierarchy, tagged unions, keywords vs symbols, strings as data

(display "--- type predicates ---\n")
(display "i64? 42: ")
(write (i64? 42))
(display "\n")
(display "f64? 3.5: ")
(write (f64? 3.5))
(display "\n")
(display "Symbol? 'x: ")
(write (Symbol? 'x))
(display "\n")
(display "Tensor? [1 2]: ")
(write (Tensor? [1 2]))
(display "\n")
(display "Bool? #t: ")
(write (Bool? #t))
(display "\n")
(display "String? \"s\": ")
(write (String? "s"))
(display "\n")

(display "--- @-intrinsics ---\n")
(display "@is-instance-of? @i64 42: ")
(write (@is-instance-of? @i64 42))
(display "\n")
(display "@is-core-type? @i64: ")
(write (@is-core-type? @i64))
(display "\n")
(display "@is-core-type? 42: ")
(write (@is-core-type? 42))
(display "\n")
(display "@type 42: ")
(write (@type 42))
(display "\n")

(display "--- type values as data ---\n")
; types are first-class values; the prelude aliases i64/f64/Tensor/...
; NOTE: = has no instance for (core.type, core.type) (ArityMismatch),
; so type values are compared by name instead of with =
(def a-type i64)
(display "a-type: ")
(write a-type)
(display "\n")
(display "Type? a-type: ")
(write (Type? a-type))
(display "\n")
(display "type of 42: ")
(write (@type 42))
(display "\n")
(display "type of 3.5: ")
(write (@type 3.5))
(display "\n")
(display "type of [1 2]: ")
(write (@type [1 2]))
(display "\n")
(display "type of \"s\": ")
(write (@type "s"))
(display "\n")

(display "--- disjointness ---\n")
; the type hierarchy is flat: an int is not a float and vice versa
(display "i64? 42: ")
(write (i64? 42))
(display "   f64? 42: ")
(write (f64? 42))
(display "\n")
(display "i64? 3.5: ")
(write (i64? 3.5))
(display "   f64? 3.5: ")
(write (f64? 3.5))
(display "\n")

(display "--- tagged union with case ---\n")
; shapes are lists tagged by keyword; case dispatches on the tag
(defn (area s)
  (case (fst s)
    ((:circle) (* pi (pow (fst (rst s)) 2.0)))
    ((:rect) (* (fst (rst s)) (fst (rst (rst s)))))
    (else -1.0)))
(display "area (list :circle 5.0): ")
(write (area (list :circle 5.0)))
(display "\n")
(display "area (list :rect 3.0 4.0): ")
(write (area (list :rect 3.0 4.0)))
(display "\n")

(display "--- keywords vs symbols ---\n")
(display ":kw: ")
(write :kw)
(display "\n")
(display "'sym: ")
(write 'sym)
(display "\n")
(display "Symbol? 'x: ")
(write (Symbol? 'x))
(display "   Keyword? 'x: ")
(write (Keyword? 'x))
(display "\n")
(display "Symbol? :x: ")
(write (Symbol? :x))
(display "   Keyword? :x: ")
(write (Keyword? :x))
(display "\n")
(display "type of :x: ")
(write (@type :x))
(display "   type of 'x: ")
(write (@type 'x))
(display "\n")

(display "--- strings as data ---\n")
(write "a string")
(display "\n")
(display "string tensor: ")
(write ["a" "b"])
(display "\n")
(display "String? \"a\": ")
(write (String? "a"))
(display "\n")

(display "--- runtime type check helper ---\n")
(defn (check v)
  (if (i64? v) (display "int")
    (if (f64? v) (display "float")
      (if (String? v) (display "string")
        (if (Tensor? v) (display "tensor")
          (if (Symbol? v) (display "symbol")
            (if (Keyword? v) (display "keyword")
              (if (Bool? v) (display "bool")
                (display "other")))))))))
(check 42)
(display " ")
(check 3.5)
(display " ")
(check "hi")
(display " ")
(check [1 2])
(display " ")
(check 'sym)
(display " ")
(check :kw)
(display " ")
(check #t)
(display "\n")

(display "done\n")
