        },
        .libffi = .{
            // Lazy: libffi's own build.zig panics for targets without
            // assembly support (wasm32-wasi, hexagon-linux, thumb-windows,
            // aarch64-windows). build.zig only resolves it via
            // b.lazyDependency inside the ffiSupported gate, so unsupported
            // targets never fetch or build it.
            .url = "git+https://codeberg.org/CoffeeImpliesCode/libffi#e101f7894db1cd6b2734103ecd6db9badd5a9ed3",
            .hash = "libffi-3.8.0-7_tEtEA6GQAepwTYbjbh7-7kl0lSqZzselVgKHGhbQEz",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "web",
        "test",
        "demo",
        // The native REPL imports zigzag for terminal width and compositing.
        "third_party/zigzag",
    },
}
