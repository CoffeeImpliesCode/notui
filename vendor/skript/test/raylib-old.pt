#!/usr/bin/env -S skript

(def raylib (dynamic-library:open "libraylib.so"))
(defn (rlget name) (dynamic-library:lookup raylib name))

(def RLColor CInt)
(def Vector2 c32)

; rgba : (-> f64 f64 f64 f64 RLColor)
(defn (rgba r g b a) (@rgba r g b a))

(def lightgray  (rgba 0.784  0.784  0.784  1.0  ))
(def gray       (rgba 0.51   0.51   0.51   1.0  ))
(def yellow     (rgba 0.992  0.976  0.0    1.0  ))
(def gold       (rgba 1.0    0.796  0.0    1.0  ))
(def pink       (rgba 1.0    0.427  0.761  1.0  ))
(def red        (rgba 0.902  0.161  0.216  1.0  ))
(def maroon     (rgba 0.745  0.129  0.216  1.0  ))
(def green      (rgba 0.0    0.894  0.188  1.0  ))
(def lime       (rgba 0.0    0.620  0.184  1.0  ))
(def darkgreen  (rgba 0.0    0.459  0.173  1.0  ))
(def skyblue    (rgba 0.4    0.749  1.0    1.0  ))
(def blue       (rgba 0.0    0.475  0.945  1.0  ))
(def darkblue   (rgba 0.0    0.322  0.675  1.0  ))
(def purple     (rgba 0.784  0.478  1.0    1.0  ))
(def violet     (rgba 0.529  0.235  0.745  1.0  ))
(def darkpurple (rgba 0.439  0.122  0.494  1.0  ))
(def beige      (rgba 0.827  0.690  0.514  1.0  ))
(def brown      (rgba 0.498  0.416  0.31   1.0  ))
(def darkbrown  (rgba 0.298  0.247  0.184  1.0  ))
(def white      (rgba 1.0    1.0    1.0    1.0  ))
(def black      (rgba 0.0    0.0    0.0    1.0  ))
(def blank      (rgba 0.0    0.0    0.0    0.0  ))
(def magenta    (rgba 1.0    0.0    1.0    1.0  ))
(def raywhite   (rgba 0.961  0.961  0.961  1.0  ))


