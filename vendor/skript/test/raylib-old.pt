; ...
; window flags
(def flag-vsync-hint                  64)
(def flag-fullscreen-mode              2)

(def flag-window-resizable             4)
(def flag-window-undecorated           8)
(def flag-window-hidden              128)
(def flag-window-minimized           512)
(def flag-window-maximized          1024)
(def flag-window-unfocused          2048)
(def flag-window-topmost            4096)
(def flag-window-always-run          256)
(def flag-window-transparent          16)
(def flag-window-highdpi            8192)
(def flag-window-mouse-passthrough 16384)
(def flag-borderless-windowed-mode 32768)

(def flag-msaa-4x-hint                32)
(def flag-interlaced-hint          65536)

; keys
(def key-null                          0)
(def key-apostrophe                   39)
(def key-comma                        44)
(def key-minus                        45)
(def key-period                       46)
(def key-slash                        47)
(def key-zero                         48)
(def key-one                          49)
(def key-two                          50)
(def key-three                        51)
(def key-four                         52)
(def key-five                         53)
(def key-six                          54)
(def key-seven                        55)
(def key-eight                        56)
(def key-nine                         57)
(def key-semicolon                    59)
(def key-equal                        61)
