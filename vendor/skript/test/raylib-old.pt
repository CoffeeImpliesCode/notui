; module: rshapes
; Basic shapes drawing functions
(def DrawPixel          (ffi:make-func (rlget "DrawPixel")    CInt   CInt   RLColor                 CVoid))
(def DrawLine           (ffi:make-func (rlget "DrawLine")     CInt   CInt   CInt    CInt    RLColor CVoid))
(def DrawCircle         (ffi:make-func (rlget "DrawCircle")   CInt   CInt   CFloat  RLColor         CVoid))
(def DrawCircleV        (ffi:make-func (rlget "DrawCircleV")  Vector2 CFloat RLColor                CVoid))

(SetConfigFlags flag-msaa-4x-hint)
(InitWindow 800 600 "Hello, World!")
(SetTargetFPS 100)

(defn (image dt)
  (ClearBackground blank)
  (DrawCircle (* 10.0 dt) 100.0 5.0 green)
  (DrawCircleV (GetMousePosition) 20.0 raywhite))

(defn (mainloop)
  (PollInputEvents)
  (BeginDrawing)
  (image (GetTime))
  (EndDrawing)
  (if (WindowShouldClose)
  ; (if @true
    @true
    (mainloop)))

; (print-disasm! mainloop)

(write "Regular Exit: " (mainloop))

(CloseWindow)
