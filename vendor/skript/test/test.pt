(defn (show-disasm! f) (write (disasm! f)))

(defn (fib n)
  (if (<= n 2)
      1
      (+ (fib (- n 1)) (fib (- n 2)))))

; (defn (fib-fast n)
;   (if (@f64.lte n 2)
;       1
;       (@f64.add (fib-fast (@f64.sub n 1)) (fib-fast (@f64.sub n 2)))))

(defn (fib-iter-inner a b n)
  (if (= n 0)
      a
      (fib-iter-inner b (+ a b) (- n 1))))
(defn (fib-iter n)
  (fib-iter-inner 0 1 n))

(show-disasm! fib-iter)
(show-disasm! fib-iter-inner)

