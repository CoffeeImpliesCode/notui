    try std.testing.expectApproxEqAbs(@as(f16, 0.0), d0[1], @as(f16, 1e-3));

    // sqrt(-1+0i) = 0 + i
    const z1 = try c16Cart(runtime, .null, .null, &.{ .f16(-1), .f16(0) });
