pub const c32Sin = makeUnaryOp(f32, [2]f32, .immediate, skript.builtins.type_c32, sinF32);
pub const c32Cos = makeUnaryOp(f32, [2]f32, .immediate, skript.builtins.type_c32, cosF32);
pub const c32Tan = makeUnaryOp(f32, [2]f32, .immediate, skript.builtins.type_c32, tanF32);
pub const c32Asin = makeUnaryOp(f32, [2]f32, .immediate, skript.builtins.type_c32, asinF32);
pub const c32Acos = makeUnaryOp(f32, [2]f32, .immediate, skript.builtins.type_c32, acosF32);
pub const c32Atan = makeUnaryOp(f32, [2]f32, .immediate, skript.builtins.type_c32, atanF32);
pub const c32Sinh = makeUnaryOp(f32, [2]f32, .immediate, skript.builtins.type_c32, sinhF32);
pub const c32Cosh = makeUnaryOp(f32, [2]f32, .immediate, skript.builtins.type_c32, coshF32);
