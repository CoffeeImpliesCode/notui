    try std.testing.expectApproxEqAbs(@as(f32, 4.0), pd[1], @as(f32, 1e-5));
}

test "c32 expm1 log1p mod rem" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();
    const z = try c32Cart(runtime, .null, .null, &.{ .f32(1.0), .f32(0.0) });
    const e = try c32Expm1(runtime, .null, .null, &.{z});
    const ed = e.obj.as([2]f32);
    try std.testing.expectApproxEqAbs(@as(f32, std.math.e - 1), ed[0], @as(f32, 1e-6));
    try std.testing.expectEqual(@as(f32, 0.0), ed[1]);
    const lz = try c32Cart(runtime, .null, .null, &.{ .f32(0.0), .f32(0.0) });
    const l = try c32Log1p(runtime, .null, .null, &.{lz});
    const ld = l.obj.as([2]f32);
    try std.testing.expectEqual(@as(f32, 0.0), ld[0]);
    try std.testing.expectEqual(@as(f32, 0.0), ld[1]);
    const a = try c32Cart(runtime, .null, .null, &.{ .f32(7.0), .f32(8.0) });
    const b = try c32Cart(runtime, .null, .null, &.{ .f32(3.0), .f32(5.0) });
    const m = try c32Mod(runtime, .null, .null, &.{ a, b });
    const md = m.obj.as([2]f32);
    try std.testing.expectEqual(@as(f32, 1.0), md[0]);
    try std.testing.expectEqual(@as(f32, 3.0), md[1]);
    const r = try c32Rem(runtime, .null, .null, &.{ a, b });
    const rd = r.obj.as([2]f32);
    try std.testing.expectEqual(@as(f32, 1.0), rd[0]);
    try std.testing.expectEqual(@as(f32, 3.0), rd[1]);
}

test "c32 clamp blend unblend remap" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();
    const x = try c32Cart(runtime, .null, .null, &.{ .f32(5.0), .f32(8.0) });
    const lo = try c32Cart(runtime, .null, .null, &.{ .f32(0.0), .f32(1.0) });
    const hi = try c32Cart(runtime, .null, .null, &.{ .f32(3.0), .f32(5.0) });
    const cl = try c32Clamp(runtime, .null, .null, &.{ x, lo, hi });
    const cld = cl.obj.as([2]f32);
    try std.testing.expectEqual(@as(f32, 3.0), cld[0]);
    try std.testing.expectEqual(@as(f32, 5.0), cld[1]);
    const a = try c32Cart(runtime, .null, .null, &.{ .f32(0.0), .f32(0.0) });
    const b = try c32Cart(runtime, .null, .null, &.{ .f32(10.0), .f32(20.0) });
    const t = try c32Cart(runtime, .null, .null, &.{ .f32(0.5), .f32(0.5) });
    const bl = try c32Blend(runtime, .null, .null, &.{ a, b, t });
    const bld = bl.obj.as([2]f32);
    try std.testing.expectEqual(@as(f32, 5.0), bld[0]);
    try std.testing.expectEqual(@as(f32, 10.0), bld[1]);
    const ub = try c32Unblend(runtime, .null, .null, &.{ a, b, bl });
    const ubd = ub.obj.as([2]f32);
    try std.testing.expectApproxEqAbs(@as(f32, 0.5), ubd[0], @as(f32, 1e-6));
    try std.testing.expectApproxEqAbs(@as(f32, 0.5), ubd[1], @as(f32, 1e-6));
    const in_lo = try c32Cart(runtime, .null, .null, &.{ .f32(0.0), .f32(0.0) });
    const in_hi = try c32Cart(runtime, .null, .null, &.{ .f32(10.0), .f32(20.0) });
    const out_lo = try c32Cart(runtime, .null, .null, &.{ .f32(100.0), .f32(200.0) });
    const out_hi = try c32Cart(runtime, .null, .null, &.{ .f32(200.0), .f32(300.0) });
    const rp = try c32Remap(runtime, .null, .null, &.{ x, in_lo, in_hi, out_lo, out_hi });
    const rpd = rp.obj.as([2]f32);
    try std.testing.expectEqual(@as(f32, 150.0), rpd[0]);
    try std.testing.expectEqual(@as(f32, 240.0), rpd[1]);
}

// ---- c16 tests for new functions ----

test "c16 fract mag polar" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();
    const z = try c16Cart(runtime, .null, .null, &.{ .f16(3.14), .f16(1.5) });
    const r = try c16Fract(runtime, .null, .null, &.{z});
    const d = r.obj.as([4]f16);
    try std.testing.expectApproxEqAbs(@as(f16, 0.14), d[0], @as(f16, 1e-2));
    try std.testing.expectApproxEqAbs(@as(f16, 0.5), d[1], @as(f16, 1e-2));
    const m = try c16Mag(runtime, .null, .null, &.{z});
    try std.testing.expectApproxEqAbs(@as(f16, 3.48), m.obj.tof16(), @as(f16, 1e-1));
    const ang: f16 = @floatCast(std.math.atan2(@as(f32, 4.0), @as(f32, 3.0)));
    const p = try c16Polar(runtime, .null, .null, &.{ .f16(5.0), .f16(ang) });
    const pd = p.obj.as([4]f16);
    try std.testing.expectApproxEqAbs(@as(f16, 3.0), pd[0], @as(f16, 1e-2));
    try std.testing.expectApproxEqAbs(@as(f16, 4.0), pd[1], @as(f16, 1e-2));
}

test "c16 expm1 log1p mod rem clamp blend unblend remap" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();
    const z = try c16Cart(runtime, .null, .null, &.{ .f16(1.0), .f16(0.0) });
    const e = try c16Expm1(runtime, .null, .null, &.{z});
    const ed = e.obj.as([4]f16);
    try std.testing.expectApproxEqAbs(@as(f16, std.math.e - 1), ed[0], @as(f16, 1e-2));
    try std.testing.expectEqual(@as(f16, 0.0), ed[1]);
    const lz = try c16Cart(runtime, .null, .null, &.{ .f16(0.0), .f16(0.0) });
    const l = try c16Log1p(runtime, .null, .null, &.{lz});
    const ld = l.obj.as([4]f16);
    try std.testing.expectEqual(@as(f16, 0.0), ld[0]);
    try std.testing.expectEqual(@as(f16, 0.0), ld[1]);
    const a = try c16Cart(runtime, .null, .null, &.{ .f16(7.0), .f16(8.0) });
    const b = try c16Cart(runtime, .null, .null, &.{ .f16(3.0), .f16(5.0) });
    const m = try c16Mod(runtime, .null, .null, &.{ a, b });
    const md = m.obj.as([4]f16);
    try std.testing.expectEqual(@as(f16, 1.0), md[0]);
    try std.testing.expectEqual(@as(f16, 3.0), md[1]);
    const r = try c16Rem(runtime, .null, .null, &.{ a, b });
    const rd = r.obj.as([4]f16);
    try std.testing.expectEqual(@as(f16, 1.0), rd[0]);
    try std.testing.expectEqual(@as(f16, 3.0), rd[1]);
    // clamp/blend/unblend/remap
    const lo = try c16Cart(runtime, .null, .null, &.{ .f16(0.0), .f16(1.0) });
    const hi = try c16Cart(runtime, .null, .null, &.{ .f16(3.0), .f16(5.0) });
    const cl = try c16Clamp(runtime, .null, .null, &.{ z, lo, hi });
    const cld = cl.obj.as([4]f16);
    try std.testing.expectEqual(@as(f16, 1.0), cld[0]);
    try std.testing.expectEqual(@as(f16, 1.0), cld[1]);
    const zero = try c16Cart(runtime, .null, .null, &.{ .f16(0.0), .f16(0.0) });
    const ten20 = try c16Cart(runtime, .null, .null, &.{ .f16(10.0), .f16(20.0) });
    const half = try c16Cart(runtime, .null, .null, &.{ .f16(0.5), .f16(0.5) });
    const bl = try c16Blend(runtime, .null, .null, &.{ zero, ten20, half });
    const bld = bl.obj.as([4]f16);
    try std.testing.expectEqual(@as(f16, 5.0), bld[0]);
    try std.testing.expectEqual(@as(f16, 10.0), bld[1]);
    const ub = try c16Unblend(runtime, .null, .null, &.{ zero, ten20, bl });
    const ubd = ub.obj.as([4]f16);
    try std.testing.expectApproxEqAbs(@as(f16, 0.5), ubd[0], @as(f16, 1e-2));
    try std.testing.expectApproxEqAbs(@as(f16, 0.5), ubd[1], @as(f16, 1e-2));
    const in_lo = try c16Cart(runtime, .null, .null, &.{ .f16(0.0), .f16(0.0) });
    const in_hi = try c16Cart(runtime, .null, .null, &.{ .f16(10.0), .f16(20.0) });
    const out_lo = try c16Cart(runtime, .null, .null, &.{ .f16(100.0), .f16(200.0) });
    const out_hi = try c16Cart(runtime, .null, .null, &.{ .f16(200.0), .f16(300.0) });
    const rp = try c16Remap(runtime, .null, .null, &.{ z, in_lo, in_hi, out_lo, out_hi });
    const rpd = rp.obj.as([4]f16);
    try std.testing.expectApproxEqAbs(@as(f16, 110.0), rpd[0], @as(f16, 1.0));
    try std.testing.expectApproxEqAbs(@as(f16, 200.0), rpd[1], @as(f16, 1.0));
}
