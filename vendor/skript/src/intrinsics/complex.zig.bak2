test "c32 abs arg norm" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    // |3+4i| = 5
    const z = try c32Cart(runtime, .null, .null, &.{ .f32(3), .f32(4) });
    const a = try c32Abs(runtime, .null, .null, &.{z});
    try std.testing.expectApproxEqAbs(@as(f32, 5.0), a.obj.tof32(), @as(f32, 1e-6));

    // arg(1+0i) = 0
    const z1 = try c32Cart(runtime, .null, .null, &.{ .f32(1), .f32(0) });
    const ar = try c32Arg(runtime, .null, .null, &.{z1});
    try std.testing.expectApproxEqAbs(@as(f32, 0.0), ar.obj.tof32(), @as(f32, 1e-6));

    // |3+4i|^2 = 25
    const n = try c32Norm(runtime, .null, .null, &.{z});
    try std.testing.expectApproxEqAbs(@as(f32, 25.0), n.obj.tof32(), @as(f32, 1e-6));

    // arg(0+i) = pi/2
    const z2 = try c32Cart(runtime, .null, .null, &.{ .f32(0), .f32(1) });
    const ar2 = try c32Arg(runtime, .null, .null, &.{z2});
    try std.testing.expectApproxEqAbs(@as(f32, std.math.pi) / 2, ar2.obj.tof32(), @as(f32, 1e-6));
}

test "c64 exp" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    // exp(0+0i) = 1+0i
    const z0 = try c64Cart(runtime, .null, .null, &.{ .f64(0), .f64(0) });
    const e0 = try c64Exp(runtime, .null, .null, &.{z0});
    const d0 = runtime.store.get([2]f64, e0.obj);
    try std.testing.expectEqual(@as(f64, 1.0), d0[0]);
    try std.testing.expectEqual(@as(f64, 0.0), d0[1]);

    // Euler: exp(0 + i*pi) = -1 + 0i
    const z1 = try c64Cart(runtime, .null, .null, &.{ .f64(0), .f64(std.math.pi) });
    const e1 = try c64Exp(runtime, .null, .null, &.{z1});
    const d1 = runtime.store.get([2]f64, e1.obj);
    try std.testing.expectApproxEqAbs(@as(f64, -1.0), d1[0], @as(f64, 1e-12));
    try std.testing.expectApproxEqAbs(@as(f64, 0.0), d1[1], @as(f64, 1e-12));
}

test "c64 log sqrt conj" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    // log(e + 0i) = 1 + 0i
    const z0 = try c64Cart(runtime, .null, .null, &.{ .f64(std.math.e), .f64(0) });
    const l = try c64Log(runtime, .null, .null, &.{z0});
    const dl = runtime.store.get([2]f64, l.obj);
    try std.testing.expectApproxEqAbs(@as(f64, 1.0), dl[0], @as(f64, 1e-12));
    try std.testing.expectApproxEqAbs(@as(f64, 0.0), dl[1], @as(f64, 1e-12));

    // sqrt(9+0i) = 3+0i
    const z1 = try c64Cart(runtime, .null, .null, &.{ .f64(9), .f64(0) });
    const s = try c64Sqrt(runtime, .null, .null, &.{z1});
    const ds = runtime.store.get([2]f64, s.obj);
    try std.testing.expectApproxEqAbs(@as(f64, 3.0), ds[0], @as(f64, 1e-12));
    try std.testing.expectApproxEqAbs(@as(f64, 0.0), ds[1], @as(f64, 1e-12));

    // conj(2-3i) = 2+3i
    const z2 = try c64Cart(runtime, .null, .null, &.{ .f64(2), .f64(-3) });
    const c = try c64Conj(runtime, .null, .null, &.{z2});
    const dc = runtime.store.get([2]f64, c.obj);
    try std.testing.expectEqual(@as(f64, 2.0), dc[0]);
    try std.testing.expectEqual(@as(f64, 3.0), dc[1]);
}

test "c64 pow" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    // (2+0i)^(0+0i) = 1+0i
    const base = try c64Cart(runtime, .null, .null, &.{ .f64(2), .f64(0) });
    const exp = try c64Cart(runtime, .null, .null, &.{ .f64(0), .f64(0) });
    const p = try c64Pow(runtime, .null, .null, &.{ base, exp });
    const d = runtime.store.get([2]f64, p.obj);
    try std.testing.expectApproxEqAbs(@as(f64, 1.0), d[0], @as(f64, 1e-12));
    try std.testing.expectApproxEqAbs(@as(f64, 0.0), d[1], @as(f64, 1e-12));
}

test "c64 abs arg norm" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    // |3+4i| = 5
    const z = try c64Cart(runtime, .null, .null, &.{ .f64(3), .f64(4) });
    const a = try c64Abs(runtime, .null, .null, &.{z});
    try std.testing.expectApproxEqAbs(@as(f64, 5.0), a.obj.tof64(), @as(f64, 1e-12));

    // arg(0+i) = pi/2
    const z1 = try c64Cart(runtime, .null, .null, &.{ .f64(0), .f64(1) });
    const ar = try c64Arg(runtime, .null, .null, &.{z1});
    try std.testing.expectApproxEqAbs(@as(f64, std.math.pi) / 2, ar.obj.tof64(), @as(f64, 1e-12));

    // |3+4i|^2 = 25
    const n = try c64Norm(runtime, .null, .null, &.{z});
    try std.testing.expectApproxEqAbs(@as(f64, 25.0), n.obj.tof64(), @as(f64, 1e-12));
}

test "c32 exp_arity_error" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();
    try std.testing.expectError(error.ArityMismatch, c32Exp(runtime, .null, .null, &.{}));
    try std.testing.expectError(error.ArityMismatch, c32Log(runtime, .null, .null, &.{}));
    try std.testing.expectError(error.ArityMismatch, c32Sqrt(runtime, .null, .null, &.{}));
    try std.testing.expectError(error.ArityMismatch, c32Conj(runtime, .null, .null, &.{}));
    try std.testing.expectError(error.ArityMismatch, c32Abs(runtime, .null, .null, &.{}));
    try std.testing.expectError(error.ArityMismatch, c32Arg(runtime, .null, .null, &.{}));
    try std.testing.expectError(error.ArityMismatch, c32Norm(runtime, .null, .null, &.{}));
    try std.testing.expectError(error.ArityMismatch, c32Pow(runtime, .null, .null, &.{.null}));
}

