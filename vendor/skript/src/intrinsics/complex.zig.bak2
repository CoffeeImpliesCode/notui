test "c32 identity: sin^2 + cos^2 = 1" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    const re: f32 = 0.7;
    const im: f32 = 1.2;
    const z = try c32Cart(runtime, .null, .null, &.{ .f32(re), .f32(im) });
    const s = try c32Sin(runtime, .null, .null, &.{z});
    const c = try c32Cos(runtime, .null, .null, &.{z});
    const sd = s.obj.as([2]f32);
    const cd = c.obj.as([2]f32);
    // sin^2 + cos^2 = 1
    const sum_sq_re = sd[0] * sd[0] - sd[1] * sd[1] + cd[0] * cd[0] - cd[1] * cd[1];
    const sum_sq_im = 2 * sd[0] * sd[1] + 2 * cd[0] * cd[1];
    try std.testing.expectApproxEqAbs(@as(f32, 1.0), sum_sq_re, @as(f32, 1e-5));
    try std.testing.expectApproxEqAbs(@as(f32, 0.0), sum_sq_im, @as(f32, 1e-5));
}

test "c32 arity error" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    try std.testing.expectError(error.ArityMismatch, c32Sin(runtime, .null, .null, &.{}));
    try std.testing.expectError(error.ArityMismatch, c32Sin(runtime, .null, .null, &.{ .null, .null }));
    try std.testing.expectError(error.ArityMismatch, c32Cos(runtime, .null, .null, &.{}));
    try std.testing.expectError(error.ArityMismatch, c32Tan(runtime, .null, .null, &.{}));
}

test "c64 sin" {
