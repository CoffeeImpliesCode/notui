// c64: multi-arg (hand-rolled)
pub fn c64Clamp(rt: *Runtime, _: Value, _: Value, args: []const Value) Error!Value {
    try intrin.arityAssert(args, 3);
    try intrin.typeAssert(args[0], skript.builtins.type_c64);
    try intrin.typeAssert(args[1], skript.builtins.type_c64);
    try intrin.typeAssert(args[2], skript.builtins.type_c64);
    const x = intrin.complexPartsStored(rt, args[0]);
    const lo = intrin.complexPartsStored(rt, args[1]);
    const hi = intrin.complexPartsStored(rt, args[2]);
    const res = complexClamp(f64, x[0], x[1], lo[0], lo[1], hi[0], hi[1]);
    const obj, const ptr, _ = try rt.store.create([2]f64);
    ptr[0] = res[0];
    ptr[1] = res[1];
    return .c64(obj);
}

