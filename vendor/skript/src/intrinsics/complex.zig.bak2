test "c32 add" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    const val_a = try c32Cart(runtime, .null, .null, &.{ .f32(1.0), .f32(2.0) });
    const val_b = try c32Cart(runtime, .null, .null, &.{ .f32(3.0), .f32(4.0) });
    const res = try c32Add(runtime, .null, .null, &.{ val_a, val_b });
    const data = res.obj.as([2]f32);
    try std.testing.expectEqual(@as(f32, 4.0), data[0]);
    try std.testing.expectEqual(@as(f32, 6.0), data[1]);
}

test "c32 sub" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    const val_a = try c32Cart(runtime, .null, .null, &.{ .f32(5.0), .f32(7.0) });
    const val_b = try c32Cart(runtime, .null, .null, &.{ .f32(3.0), .f32(4.0) });
    const res = try c32Sub(runtime, .null, .null, &.{ val_a, val_b });
    const data = res.obj.as([2]f32);
    try std.testing.expectEqual(@as(f32, 2.0), data[0]);
    try std.testing.expectEqual(@as(f32, 3.0), data[1]);
}

test "c32 mul" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    const val_a = try c32Cart(runtime, .null, .null, &.{ .f32(1.0), .f32(2.0) });
    const val_b = try c32Cart(runtime, .null, .null, &.{ .f32(3.0), .f32(4.0) });
    const res = try c32Mul(runtime, .null, .null, &.{ val_a, val_b });
    const data = res.obj.as([2]f32);
    // (1+2i)*(3+4i) = (3-8) + (4+6)i = -5 + 10i
    try std.testing.expectEqual(@as(f32, -5.0), data[0]);
    try std.testing.expectEqual(@as(f32, 10.0), data[1]);
}

test "c32 div" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    const val_a = try c32Cart(runtime, .null, .null, &.{ .f32(1.0), .f32(2.0) });
    const val_b = try c32Cart(runtime, .null, .null, &.{ .f32(3.0), .f32(4.0) });
    const res = try c32Div(runtime, .null, .null, &.{ val_a, val_b });
    const data = res.obj.as([2]f32);
    // (1+2i)/(3+4i) = (1*3+2*4)/(25) + (2*3-1*4)/(25)i = 11/25 + 2/25i = 0.44 + 0.08i
    try std.testing.expectApproxEqAbs(@as(f32, 0.44), data[0], @as(f32, 1e-7));
    try std.testing.expectApproxEqAbs(@as(f32, 0.08), data[1], @as(f32, 1e-7));
}

test "c64 add" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    const val_a = try c64Cart(runtime, .null, .null, &.{ .f64(1.0), .f64(2.0) });
    const val_b = try c64Cart(runtime, .null, .null, &.{ .f64(3.0), .f64(4.0) });
    const res = try c64Add(runtime, .null, .null, &.{ val_a, val_b });
    const data = runtime.store.get([2]f64, res.obj);
    try std.testing.expectEqual(@as(f64, 4.0), data[0]);
    try std.testing.expectEqual(@as(f64, 6.0), data[1]);
}

test "c64 mul identity" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    // (1+0i) * (a+bi) = (a+bi)
    const one = try c64Cart(runtime, .null, .null, &.{ .f64(1.0), .f64(0.0) });
    const val = try c64Cart(runtime, .null, .null, &.{ .f64(3.0), .f64(4.0) });
    const res = try c64Mul(runtime, .null, .null, &.{ one, val });
    const data = runtime.store.get([2]f64, res.obj);
    try std.testing.expectEqual(@as(f64, 3.0), data[0]);
    try std.testing.expectEqual(@as(f64, 4.0), data[1]);
}

test "c16 arity error" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    try std.testing.expectError(error.ArityMismatch, c16Cart(runtime, .null, .null, &.{.f16(1.0)}));
    try std.testing.expectError(error.ArityMismatch, c16Re(runtime, .null, .null, &.{}));
    try std.testing.expectError(error.ArityMismatch, c16Add(runtime, .null, .null, &.{.c16(.{ 1, 2 })}));
}

test "c32 type assertion error" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    try std.testing.expectError(error.TypeMismatch, c32Cart(runtime, .null, .null, &.{ .f32(1.0), .f64(2.0) }));
}

// ---- complex trigonometric function tests ----

test "c32 sin" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    // sin(0+0i) = 0+0i
    const z0 = try c32Cart(runtime, .null, .null, &.{ .f32(0), .f32(0) });
    const s0 = try c32Sin(runtime, .null, .null, &.{z0});
    const d0 = s0.obj.as([2]f32);
    try std.testing.expectEqual(@as(f32, 0.0), d0[0]);
    try std.testing.expectEqual(@as(f32, 0.0), d0[1]);

    // sin(pi/2 + 0i) = 1 + 0i
    const z1 = try c32Cart(runtime, .null, .null, &.{ .f32(@as(f32, std.math.pi) / 2), .f32(0) });
    const s1 = try c32Sin(runtime, .null, .null, &.{z1});
    const d1 = s1.obj.as([2]f32);
    try std.testing.expectApproxEqAbs(@as(f32, 1.0), d1[0], @as(f32, 1e-6));
    try std.testing.expectApproxEqAbs(@as(f32, 0.0), d1[1], @as(f32, 1e-6));

    // sin(0 + i) = 0 + i*sinh(1)
    const z2 = try c32Cart(runtime, .null, .null, &.{ .f32(0), .f32(1) });
    const s2 = try c32Sin(runtime, .null, .null, &.{z2});
    const d2 = s2.obj.as([2]f32);
    try std.testing.expectApproxEqAbs(@as(f32, 0.0), d2[0], @as(f32, 1e-6));
    try std.testing.expectApproxEqAbs(@as(f32, std.math.sinh(@as(f32, 1.0))), d2[1], @as(f32, 1e-6));
}

test "c32 cos" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    // cos(0+0i) = 1+0i
    const z0 = try c32Cart(runtime, .null, .null, &.{ .f32(0), .f32(0) });
    const c0 = try c32Cos(runtime, .null, .null, &.{z0});
    const d0 = c0.obj.as([2]f32);
    try std.testing.expectEqual(@as(f32, 1.0), d0[0]);
    try std.testing.expectEqual(@as(f32, 0.0), d0[1]);

    // cos(pi/2 + 0i) = 0 + 0i
    const z1 = try c32Cart(runtime, .null, .null, &.{ .f32(@as(f32, std.math.pi) / 2), .f32(0) });
    const c1 = try c32Cos(runtime, .null, .null, &.{z1});
    const d1 = c1.obj.as([2]f32);
    try std.testing.expectApproxEqAbs(@as(f32, 0.0), d1[0], @as(f32, 1e-6));
    try std.testing.expectApproxEqAbs(@as(f32, 0.0), d1[1], @as(f32, 1e-6));
}

