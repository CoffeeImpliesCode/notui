pub const c32Acosh = makeUnaryOp(f32, [2]f32, .immediate, skript.builtins.type_c32, acoshF32);
pub const c32Atanh = makeUnaryOp(f32, [2]f32, .immediate, skript.builtins.type_c32, atanhF32);

pub const c32Exp = makeUnaryOp(f32, [2]f32, .immediate, skript.builtins.type_c32, expF32);
pub const c32Log = makeUnaryOp(f32, [2]f32, .immediate, skript.builtins.type_c32, logF32);
pub const c32Sqrt = makeUnaryOp(f32, [2]f32, .immediate, skript.builtins.type_c32, sqrtF32);
pub const c32Conj = makeUnaryOp(f32, [2]f32, .immediate, skript.builtins.type_c32, conjF32);
pub const c32Neg = makeUnaryOp(f32, [2]f32, .immediate, skript.builtins.type_c32, negF32);
pub const c32Pow = makeBinOp(f32, [2]f32, Pow, .immediate, skript.builtins.type_c32);

pub fn c32Abs(_: *Runtime, _: Value, _: Value, args: []const Value) Error!Value {
    try intrin.arityAssert(args, 1);
    try intrin.typeAssert(args[0], skript.builtins.type_c32);
    const parts = intrin.complexParts(f32, args[0]);
    return convertToValue(complexAbs(f32, parts[0], parts[1]));
}

pub fn c32Arg(_: *Runtime, _: Value, _: Value, args: []const Value) Error!Value {
    try intrin.arityAssert(args, 1);
    try intrin.typeAssert(args[0], skript.builtins.type_c32);
    const parts = intrin.complexParts(f32, args[0]);
    return convertToValue(complexArg(f32, parts[0], parts[1]));
}

