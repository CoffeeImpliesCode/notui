// ---- f16 helpers (upcast to f32 for stdlib math support) ----

fn sinF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexSin(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}
fn cosF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexCos(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}
fn tanF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexTan(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}
fn asinF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexAsin(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}
fn acosF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexAcos(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}
fn atanF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexAtan(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}
fn sinhF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexSinh(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}
fn coshF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexCosh(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}
fn tanhF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexTanh(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}
fn asinhF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexAsinh(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}
fn acoshF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexAcosh(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}
fn atanhF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexAtanh(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}
fn expF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexExp(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}
fn logF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexLog(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}
fn sqrtF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexSqrt(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}
fn conjF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexConj(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}
fn negF16(re: f16, im: f16) struct { f16, f16 } {
    return .{ -re, -im };
}
fn absF16(re: f16, im: f16) f16 {
    return @floatCast(complexAbs(f32, @as(f32, re), @as(f32, im)));
}
fn argF16(re: f16, im: f16) f16 {
    return @floatCast(complexArg(f32, @as(f32, re), @as(f32, im)));
}
fn normF16(re: f16, im: f16) f16 {
    return @floatCast(complexNorm(f32, @as(f32, re), @as(f32, im)));
}

fn powF16(re_a: f16, im_a: f16, re_b: f16, im_b: f16) struct { f16, f16 } {
    const r = complexPow(f32, @as(f32, re_a), @as(f32, im_a), @as(f32, re_b), @as(f32, im_b));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}

fn fractF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexFract(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}

fn modF16(re_a: f16, im_a: f16, re_b: f16, im_b: f16) struct { f16, f16 } {
    const r = complexMod(f32, @as(f32, re_a), @as(f32, im_a), @as(f32, re_b), @as(f32, im_b));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}

fn remF16(re_a: f16, im_a: f16, re_b: f16, im_b: f16) struct { f16, f16 } {
    const r = complexRem(f32, @as(f32, re_a), @as(f32, im_a), @as(f32, re_b), @as(f32, im_b));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}

fn clampF16(
    x_re: f16,
    x_im: f16,
    lo_re: f16,
    lo_im: f16,
    hi_re: f16,
    hi_im: f16,
) struct { f16, f16 } {
    const r = complexClamp(
        f32,
        @as(f32, x_re),
        @as(f32, x_im),
        @as(f32, lo_re),
        @as(f32, lo_im),
        @as(f32, hi_re),
        @as(f32, hi_im),
    );
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}

fn blendF16(
    a_re: f16,
    a_im: f16,
    b_re: f16,
    b_im: f16,
    t_re: f16,
    t_im: f16,
) struct { f16, f16 } {
    const r = complexBlend(
        f32,
        @as(f32, a_re),
        @as(f32, a_im),
        @as(f32, b_re),
        @as(f32, b_im),
        @as(f32, t_re),
        @as(f32, t_im),
    );
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}

fn unblendF16(
    a_re: f16,
    a_im: f16,
    b_re: f16,
    b_im: f16,
    v_re: f16,
    v_im: f16,
) struct { f16, f16 } {
    const r = complexUnblend(
        f32,
        @as(f32, a_re),
        @as(f32, a_im),
        @as(f32, b_re),
        @as(f32, b_im),
        @as(f32, v_re),
        @as(f32, v_im),
    );
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}

fn remapF16(
    x_re: f16,
    x_im: f16,
    in_lo_re: f16,
    in_lo_im: f16,
    in_hi_re: f16,
    in_hi_im: f16,
    out_lo_re: f16,
    out_lo_im: f16,
    out_hi_re: f16,
    out_hi_im: f16,
) struct { f16, f16 } {
    const r = complexRemap(
        f32,
        @as(f32, x_re),
        @as(f32, x_im),
        @as(f32, in_lo_re),
        @as(f32, in_lo_im),
        @as(f32, in_hi_re),
        @as(f32, in_hi_im),
        @as(f32, out_lo_re),
        @as(f32, out_lo_im),
        @as(f32, out_hi_re),
        @as(f32, out_hi_im),
    );
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}

fn polarF16(mag: f16, ang: f16) struct { f16, f16 } {
    const r = complexPolar(f32, @as(f32, mag), @as(f32, ang));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}

fn expm1F16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexExpm1(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}

fn log1pF16(re: f16, im: f16) struct { f16, f16 } {
    const r = complexLog1p(f32, @as(f32, re), @as(f32, im));
    return .{ @floatCast(r[0]), @floatCast(r[1]) };
}

pub const c16Sin = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, sinF16);
pub const c16Cos = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, cosF16);
pub const c16Tan = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, tanF16);
pub const c16Asin = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, asinF16);
pub const c16Acos = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, acosF16);
pub const c16Atan = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, atanF16);
pub const c16Sinh = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, sinhF16);
pub const c16Cosh = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, coshF16);
pub const c16Tanh = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, tanhF16);
pub const c16Asinh = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, asinhF16);
pub const c16Acosh = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, acoshF16);
pub const c16Atanh = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, atanhF16);
pub const c16Exp = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, expF16);
pub const c16Log = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, logF16);
pub const c16Sqrt = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, sqrtF16);
pub const c16Conj = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, conjF16);
pub const c16Neg = makeUnaryOp(f16, [4]f16, .immediate, skript.builtins.type_c16, negF16);

pub fn c16Pow(_: *Runtime, _: Value, _: Value, args: []const Value) Error!Value {
    try intrin.arityAssert(args, 2);
    try intrin.typeAssert(args[0], skript.builtins.type_c16);
    try intrin.typeAssert(args[1], skript.builtins.type_c16);
    const a = intrin.complexParts(f16, args[0]);
    const b = intrin.complexParts(f16, args[1]);
    const res = powF16(a[0], a[1], b[0], b[1]);
    return .c16(.{ res[0], res[1] });
}

pub fn c16Abs(_: *Runtime, _: Value, _: Value, args: []const Value) Error!Value {
    try intrin.arityAssert(args, 1);
    try intrin.typeAssert(args[0], skript.builtins.type_c16);
    const parts = intrin.complexParts(f16, args[0]);
    return convertToValue(absF16(parts[0], parts[1]));
}

pub fn c16Arg(_: *Runtime, _: Value, _: Value, args: []const Value) Error!Value {
    try intrin.arityAssert(args, 1);
    try intrin.typeAssert(args[0], skript.builtins.type_c16);
    const parts = intrin.complexParts(f16, args[0]);
    return convertToValue(argF16(parts[0], parts[1]));
}

pub fn c16Norm(_: *Runtime, _: Value, _: Value, args: []const Value) Error!Value {
    try intrin.arityAssert(args, 1);
    try intrin.typeAssert(args[0], skript.builtins.type_c16);
    const parts = intrin.complexParts(f16, args[0]);
    return convertToValue(normF16(parts[0], parts[1]));
}

// ---- re / im extractors ----

fn makeReIm(comptime Storage: type, comptime mode: StorageMode, comptime complex_type: Object, comptime idx: usize) Func {
    return struct {
        fn f(rt: *Runtime, _: Value, _: Value, args: []const Value) Error!Value {
            if (args.len != 1) return error.ArityMismatch;
            const val = args[0];
            if (mode == .stored) {
                if (val.typ != skript.builtins.type_c64) return error.TypeMismatch;
                return convertToValue(rt.store.get([2]f64, val.obj)[idx]);
            } else {
                if (val.typ != complex_type) return error.TypeMismatch;
                return convertToValue(val.obj.as(Storage)[idx]);
            }
        }
    }.f;
}

pub const c16Re = makeReIm([4]f16, .immediate, skript.builtins.type_c16, 0);
pub const c16Im = makeReIm([4]f16, .immediate, skript.builtins.type_c16, 1);
pub const c32Re = makeReIm([2]f32, .immediate, skript.builtins.type_c32, 0);
pub const c32Im = makeReIm([2]f32, .immediate, skript.builtins.type_c32, 1);
pub const c64Re = makeReIm([2]f64, .stored, skript.builtins.type_c64, 0);
pub const c64Im = makeReIm([2]f64, .stored, skript.builtins.type_c64, 1);

// ---- complex equality ----

fn makeCmp(comptime Storage: type, comptime mode: StorageMode, comptime complex_type: Object, comptime op: std.math.CompareOperator) Func {
    return struct {
        fn f(rt: *Runtime, _: Value, _: Value, args: []const Value) Error!Value {
            try intrin.arityAssert(args, 2);
            try intrin.typeAssert(args[0], complex_type);
            try intrin.typeAssert(args[1], complex_type);
            const a, const b = if (mode == .stored)
                .{ rt.store.get([2]f64, args[0].obj), rt.store.get([2]f64, args[1].obj) }
            else
                .{ args[0].obj.as(Storage), args[1].obj.as(Storage) };
            const re = std.math.compare(a[0], op, b[0]);
            const im = std.math.compare(a[1], op, b[1]);
            return switch (op) {
                .eq => .bool(re and im),
                .neq => .bool(re or im),
                else => @compileError("Unsupported compare operator for complex: " ++ @tagName(op)),
            };
        }
    }.f;
}

pub const c16Eq = makeCmp([4]f16, .immediate, skript.builtins.type_c16, .eq);
pub const c32Eq = makeCmp([2]f32, .immediate, skript.builtins.type_c32, .eq);
pub const c64Eq = makeCmp([2]f64, .stored, skript.builtins.type_c64, .eq);
pub const c16Ne = makeCmp([4]f16, .immediate, skript.builtins.type_c16, .neq);
pub const c32Ne = makeCmp([2]f32, .immediate, skript.builtins.type_c32, .neq);
pub const c64Ne = makeCmp([2]f64, .stored, skript.builtins.type_c64, .neq);

// ---- complex predicates ----

fn makePred(comptime Storage: type, comptime complex_type: Object, comptime pred: anytype) Func {
    return struct {
        fn f(_: *Runtime, _: Value, _: Value, args: []const Value) Error!Value {
            try intrin.arityAssert(args, 1);
            try intrin.typeAssert(args[0], complex_type);
            const v = args[0].obj.as(Storage);
            return .bool(pred(v));
        }
    }.f;
}

fn makePredStored(comptime pred: anytype) Func {
    return struct {
        fn f(rt: *Runtime, _: Value, _: Value, args: []const Value) Error!Value {
            try intrin.arityAssert(args, 1);
            try intrin.typeAssert(args[0], skript.builtins.type_c64);
            const v = rt.store.get([2]f64, args[0].obj);
            return .bool(pred(v));
        }
    }.f;
}

fn isZeroImmediate(storage: anytype) bool {
    return storage[0] == 0 and storage[1] == 0;
}
fn isNanImmediate(storage: anytype) bool {
    return std.math.isNan(storage[0]) or std.math.isNan(storage[1]);
}
fn isInfImmediate(storage: anytype) bool {
    return std.math.isInf(storage[0]) or std.math.isInf(storage[1]);
}
fn isFiniteImmediate(storage: anytype) bool {
    return std.math.isFinite(storage[0]) and std.math.isFinite(storage[1]);
}

pub const c16IsZero = makePred([4]f16, skript.builtins.type_c16, isZeroImmediate);
pub const c16IsNan = makePred([4]f16, skript.builtins.type_c16, isNanImmediate);
pub const c16IsInf = makePred([4]f16, skript.builtins.type_c16, isInfImmediate);
pub const c16IsFinite = makePred([4]f16, skript.builtins.type_c16, isFiniteImmediate);
pub const c32IsZero = makePred([2]f32, skript.builtins.type_c32, isZeroImmediate);
pub const c32IsNan = makePred([2]f32, skript.builtins.type_c32, isNanImmediate);
pub const c32IsInf = makePred([2]f32, skript.builtins.type_c32, isInfImmediate);
pub const c32IsFinite = makePred([2]f32, skript.builtins.type_c32, isFiniteImmediate);
pub const c64IsZero = makePredStored(isZeroImmediate);
pub const c64IsNan = makePredStored(isNanImmediate);
pub const c64IsInf = makePredStored(isInfImmediate);
pub const c64IsFinite = makePredStored(isFiniteImmediate);

test "force analysis of all decls" {
    comptime {
        std.testing.refAllDecls(@This());
    }
}

// ---- tests ----

fn initTestingRuntime() !*Runtime {
    return Runtime.init(std.testing.allocator, std.testing.io);
}

test "c16Cart round-trip" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    const val = try c16Cart(runtime, .null, .null, &.{ .f16(1.5), .f16(2.5) });
    try std.testing.expectEqual(skript.builtins.type_c16, val.typ);
    const data = val.obj.as([4]f16);
    try std.testing.expectEqual(@as(f16, 1.5), data[0]);
    try std.testing.expectEqual(@as(f16, 2.5), data[1]);
}

test "c32Cart round-trip" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    const val = try c32Cart(runtime, .null, .null, &.{ .f32(1.5), .f32(2.5) });
    try std.testing.expectEqual(skript.builtins.type_c32, val.typ);
    const data = val.obj.as([2]f32);
    try std.testing.expectEqual(@as(f32, 1.5), data[0]);
    try std.testing.expectEqual(@as(f32, 2.5), data[1]);
}

test "c64Cart round-trip" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    const val = try c64Cart(runtime, .null, .null, &.{ .f64(1.5), .f64(2.5) });
    try std.testing.expectEqual(skript.builtins.type_c64, val.typ);
    const data = runtime.store.get([2]f64, val.obj);
    try std.testing.expectEqual(@as(f64, 1.5), data[0]);
    try std.testing.expectEqual(@as(f64, 2.5), data[1]);
}

test "c16Re and c16Im" {
    const runtime = try initTestingRuntime();
    defer runtime.deinit();

    const val = try c16Cart(runtime, .null, .null, &.{ .f16(3.0), .f16(4.0) });
    const real = try c16Re(runtime, .null, .null, &.{val});
    const imag = try c16Im(runtime, .null, .null, &.{val});
    try std.testing.expectEqual(skript.builtins.type_f16, real.typ);
    try std.testing.expectEqual(skript.builtins.type_f16, imag.typ);
    try std.testing.expectEqual(@as(f16, 3.0), real.obj.tof16());
    try std.testing.expectEqual(@as(f16, 4.0), imag.obj.tof16());
}

