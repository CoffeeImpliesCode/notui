(def =                 (method))
(instance = i64 i64 @i64.eq)
(instance = i8 i8 @i8.eq)
(instance = i16 i16 @i16.eq)
(instance = i32 i32 @i32.eq)
(instance = u8 u8 @u8.eq)
(instance = u16 u16 @u16.eq)
(instance = u32 u32 @u32.eq)
(instance = u64 u64 @u64.eq)
(instance = f16 f16 @f16.eq)
(instance = f32 f32 @f32.eq)
(instance = f64 f64 @f64.eq)
(instance = c16 c16 @c16.eq)
(instance = c32 c32 @c32.eq)
(instance = c64 c64 @c64.eq)
(instance = pid pid @pid.eq)
(instance = Tensor Tensor @tensor.eq)
; Symbols and keywords are interned, so equality is object identity.
(instance = Symbol Symbol @symbol.eq)
(instance = Keyword Keyword @keyword.eq)
; Strings compare by content (byte-wise over the NUL-terminated slice).
(instance = String String @string.eq)
; Opaque values compare by object identity (covers the receive-timeout
; sentinel: every (timeout-sentinel) returns the SAME interned opaque, so
; (= v (timeout-sentinel)) tests for a receive timeout).
(instance = Opaque Opaque @equal?)

