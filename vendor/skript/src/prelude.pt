; --- Error system (05-io-system §5): error values, raise/try/guard ---
(def error?            @error?)
(def error-name        @error-name)
(def error-location    @error-location)
(def error-trace       @error-trace)
(defn (error msg)      (raise msg))

(def nil              @nil)
(def #t                @true)
(def #f                @false)
(def else              @true)

; Core arithmetic/comparison dispatch is non-overridable: lock the builtin
; methods so a later (instance + i64 i64 custom) is refused (error.Unsupported).
; User-type extensions of these methods (a non-builtin spec) stay allowed.
(def lock-method       @lock-method)
(lock-method +)
(lock-method -)
(lock-method *)
(lock-method /)
(lock-method =)
(lock-method !=)
(lock-method <)
(lock-method >)
(lock-method <=)
(lock-method >=)
