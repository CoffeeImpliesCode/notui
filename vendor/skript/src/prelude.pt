(def c64.polar         @c64.polar)

(def mag               (method))
(instance mag c16 @c16.mag)
(instance mag c32 @c32.mag)
(instance mag c64 @c64.mag)

(def polar             (method))
(instance polar f16 f16 @c16.polar)
(instance polar f32 f32 @c32.polar)
(instance polar f64 f64 @c64.polar)

(defn (avg xs)
  (if (f64? (fst xs))  (@f64.avg xs)
    (if (f32? (fst xs))  (@f32.avg xs)
      (if (f16? (fst xs))  (@f16.avg xs)
        (@f64.avg xs)))))

(def write           @write)
(def display          @display)

(def cons              @cons)
(def fst               @fst)
(def rst               @rst)
