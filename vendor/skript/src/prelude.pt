(def map-size          @map-size)
(def even?             is-even?)
; compose (AlgoId 5020): binary, right-to-left — f ∘ g applies g then f.
; Returns a closure; callability of f/g is not checked at construction
; (the error surfaces on application, same as fn).
(defn (compose f g)    (fn (x) (f (g x))))

