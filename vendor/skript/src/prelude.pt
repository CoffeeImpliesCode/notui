(defn (Type? x)        (@is-instance-of? @Type   x))
(defn (Bool? x)        (@is-instance-of? @Bool   x))
(defn (f8?  x)         (@is-instance-of? @f8     x))
(defn (f16? x)         (@is-instance-of? @f16    x))
(defn (f32? x)         (@is-instance-of? @f32    x))
(defn (f64? x)         (@is-instance-of? @f64    x))
(defn (i8?  x)         (@is-instance-of? @i8     x))
(defn (i16? x)         (@is-instance-of? @i16    x))
(defn (i32? x)         (@is-instance-of? @i32    x))
(defn (i64? x)         (@is-instance-of? @i64    x))
(defn (u8?  x)         (@is-instance-of? @u8     x))
(defn (u16? x)         (@is-instance-of? @u16    x))
(defn (u32? x)         (@is-instance-of? @u32    x))
(defn (u64? x)         (@is-instance-of? @u64    x))
(defn (c8?  x)         (@is-instance-of? @c8     x))
(defn (c16? x)         (@is-instance-of? @c16    x))
(defn (c32? x)         (@is-instance-of? @c32    x))
(defn (c64? x)         (@is-instance-of? @c64    x))
(defn (Symbol? x)      (@is-instance-of? @Symbol x))
(defn (String? x)      (@is-instance-of? @String x))
(defn (Opaque? x)      (@is-instance-of? @Opaque x))
(def Keyword          @Keyword)
(defn (nil? x)        (@is-instance-of? @Nil x))
(defn (Keyword? x)    (@is-instance-of? @Keyword x))
(def Tensor           @Tensor)
(def ByteVector        @ByteVector)
(def bytevector?       @bytevector?)
(def bytevector-length @bytevector-length)
(def bytevector-ref    @bytevector-ref)
(defn (Tensor? x)     (@is-instance-of? @Tensor x))

; ---- per-type predicates (exact tag tests; SEMANTICS §3.2 disjoint set) ----
; The @Type-style constants for the six non-numeric tags below are registered
; as intrinsics (@cons? …) rather than Runtime.zig constants — same exact
; typ == tag semantics.
(defn (symbol? x)     (@is-instance-of? @Symbol x))
(defn (string? x)     (@is-instance-of? @String x))
(defn (bool? x)       (@is-instance-of? @Bool x))
(defn (opaque? x)     (@is-instance-of? @Opaque x))
(defn (cons? x)       (@cons? x))
(defn (closure? x)    (@closure? x))
(defn (intrinsic? x)  (@intrinsic? x))
(defn (ffifunc? x)    (@ffifunc? x))
(defn (method? x)     (@method? x))
(defn (namespace? x)  (@namespace? x))

; ---- aggregate numeric predicates (mask tests; SEMANTICS §3.2) ----
; Flat-tag semantics: a value's ACTUAL tag is tested, so (complex? 1) is #f
; and (real? 1+2i) is #f (divergence from R7RS, documented). Predicates are
; total — (cons? 42) is #f, never an error.
(defn (number? x)     (@number? x))
(defn (real? x)       (@real? x))
(defn (int? x)        (@int? x))
(defn (float? x)      (@float? x))
(defn (complex? x)    (@complex? x))

