(def map-get           @map-get)
(def map-set!          @map-set!)
(def symbol            @symbol)

; --- TIER-1/2/3 string module (04-strings-format.md) ---
; Primarily byte-level v1 semantics: string-length counts BYTES, string-find/
; -split match byte sequences, string-byte-ref is byte-indexed. The char-aware
; ops are string-reverse, substring, string->list/list->string (UTF-8 codepoint
; aware). The whitespace set trimmed by string-trim* is " \t\n\r" — identical
; to the set makeSymbol trims for (string->symbol), keeping the two consistent.
(def string-append       @string.append)
; Deep same-type structural equality (SEM:§6.1). eqv? will alias this when
; added (no exact/inexact split to distinguish them).
(def equal?              @equal?)
(def string-length       @string.length)
(def string=?            @string.eq)
(def string!=            @string.ne)
(def string<?            @string.lt)
(def string>?            @string.gt)
(def string<=?           @string.lte)
(def string>=?           @string.gte)
(def string-upcase       @string.upcase)
(def string-downcase     @string.downcase)
(def string-find         @string.find)
(def string-replace      @string.replace)
(def string-split        @string.split)
(def string-join         @string.join)
(def string-trim         @string.trim)
(def string-trim-left    @string.trim-left)
(def string-trim-right   @string.trim-right)
(def string-includes?    @string.includes?)
(def string-starts-with? @string.starts-with?)
(def string-ends-with?   @string.ends-with?)
(def string-reverse      @string.reverse)
(def substring           @string.substring)
(def string-byte-ref     @string.byte-ref)
(def number->string      @string.number->string)
(def string->number      @string.string->number)
; (string->symbol) is a pure alias of the existing @symbol intrinsic:
; asserts string, trims " \t\n\r", interns via the store.
(def string->symbol      @symbol)
(def symbol->string      @string.from-symbol)
(def string->list        @string.to-list)
(def list->string        @string.from-list)
(def format              @format)
(def printf              @printf)

